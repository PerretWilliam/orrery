# Public https origin of the instance (enables GitHub webhooks).
ORRERY_PUBLIC_URL=
# Optional.
ORRERY_SETUP_TOKEN=
ORRERY_ADMINS=
ORRERY_SIGNIN_ALLOWLIST=
