{
  "name": "orrery",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "demo": "tsx scripts/demo/run.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:security": "vitest run tests/security",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:e2e": "playwright test",
    "mutation": "stryker run",
    "size": "node scripts/shell-size.mjs && node scripts/widget-budgets.mjs",
    "lighthouse": "lhci autorun",
    "lighthouse:tab": "tsx scripts/lighthouse-tab.ts",
    "audit:deps": "npm audit --omit=dev",
    "ci:local": "npm run typecheck && npm run lint && npm run db:check && npm run coverage && npm run build && npm run size",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "cli:build": "node scripts/build-cli.mjs",
    "schema:generate": "UPDATE_SCHEMA=1 vitest run src/features/config/domain/json-schema.test.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@tanstack/react-query": "^5.108.3",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.28",
    "@yusufceng1z/ding-react": "0.0.9",
    "better-auth": "1.7.27",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.77.0",
    "next": "16.4.6",
    "next-intl": "^4.15.3",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "^3.11.0",
    "tailwind-merge": "^3.7.1",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@lhci/cli": "^0.16.1",
    "@playwright/test": "^1.65.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@tailwindcss/turbopack": "4.3.5",
    "@testcontainers/postgresql": "^12.2.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^10",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-security": "^4.2.1",
    "jsdom": "^31.0.1",
    "msw": "^3.0.7",
    "shadcn": "^4.23.0",
    "tailwindcss": "4.3.5",
    "testcontainers": "^12.2.2",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "qs": "^6.16.1",
    "minimatch@>=7 <11.0.1": "^11.0.1",
    "archiver-utils": {
      "glob": "^14.0.2"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    }
  },
  "bin": {
    "orrery": "dist/cli/orrery.cjs"
  }
}
