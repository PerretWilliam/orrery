{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.mts"
  },
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/features/config/domain/**/*.ts",
    "src/features/access/domain/**/*.ts",
    "src/features/secrets/domain/**/*.ts",
    "src/features/data-proxy/domain/**/*.ts",
    "src/features/setup/domain/**/*.ts",
    "src/features/setup/server/service.ts",
    "src/features/auth/domain/**/*.ts",
    "src/features/auth/server/service.ts",
    "src/features/auth/server/auth-secret.ts",
    "src/features/auth/server/http.ts",
    "src/features/access/server/permissions.ts",
    "src/features/access/server/guarded-cache.ts",
    "src/features/access/server/policy.ts",
    "src/features/access/server/seed.ts",
    "src/features/webhooks/domain/**/*.ts",
    "src/features/webhooks/server/handler.ts",
    "src/features/webhooks/server/body.ts",
    "src/features/repos/domain/**/*.ts",
    "src/features/repos/server/github.ts",
    "src/features/repos/server/discovery.ts",
    "src/lib/ssrf-guard*.ts",
    "src/lib/crypto*.ts",
    "!src/**/*.test.ts",
    "src/lib/utils.ts"
  ],
  "thresholds": {
    "high": 95,
    "low": 90,
    "break": 90
  },
  "reporters": [
    "clear-text",
    "html"
  ],
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "ignoreStatic": false,
  "incremental": true,
  "incrementalFile": "reports/stryker-incremental.json"
}
